<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.SET_ALARM"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- v2.11.3: instalar la actualización descargada desde dentro de la app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- v2.9.0: poder LEER la agenda. Kiu ya sabía escribir eventos (addCalendarEvent
         abre el calendario del sistema), pero no leer: "¿qué tengo mañana?" no tenía
         respuesta. Solo lectura, y se pide en el momento, no al instalar. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>

    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.flash" android:required="false"/>

    <!-- v2.8.1 · BUG CRÍTICO: desde Android 11 (API 30) la app NO ve los servicios de
         voz del sistema sin esto. Documentación oficial de SpeechRecognizer:
         "For apps targeting Android 11 interaction with a speech recognition service
         requires element to be added to the manifest file". Sin el <queries>:
           · SpeechRecognizer.isRecognitionAvailable() devuelve false SIEMPRE
           · KiuService.cycle() reprograma cada 6 s y nunca escucha → la palabra de
             activación no responde nunca
           · MainActivity.startSpeech() entra por la rama 'unavailable' → el modo
             conversación continua no abre el micrófono nunca
         Los dos fallos que se reportaban eran el mismo. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- motor de TTS: sin esto el WebView tampoco resuelve el motor de voz -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <package android:name="com.whatsapp"/>
        <package android:name="com.instagram.android"/>
        <package android:name="com.facebook.katana"/>
        <package android:name="com.google.android.youtube"/>
        <package android:name="com.spotify.music"/>
        <package android:name="com.google.android.gm"/>
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.android.chrome"/>
        <package android:name="org.telegram.messenger"/>
        <package android:name="com.zhiliaoapp.musically"/>
        <package android:name="com.netflix.mediaclient"/>
        <package android:name="com.twitter.android"/>
        <package android:name="com.android.vending"/>
        <package android:name="com.google.android.deskclock"/>
        <package android:name="com.google.android.calendar"/>
        <package android:name="com.google.android.calculator"/>
        <package android:name="com.android.calculator2"/>
        <package android:name="com.google.android.keep"/>
        <package android:name="com.google.android.apps.youtube.music"/>
    </queries>

    <!-- v2.9.9: extractNativeLibs se fue de acá. AGP avisa que ese atributo tiene
         que estar en el archivo de build, y ya está: packaging { jniLibs.useLegacyPackaging
         = true }. Estaba en los dos lados y el que manda es el build; el del manifiesto
         era ruido que además generaba un warning en cada compilación.

         OJO: el comentario va antes del tag, no adentro. En XML un comentario no
         puede ir entre los atributos de un start-tag, y ponerlo ahí rompe el
         manifiesto entero. -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".KiuService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>

        <!-- v2.11.3: entrega el APK de la actualización al instalador (solo lectura, solo carpeta updates) -->
        <provider
            android:name=".KiuApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true"/>

        <receiver android:name=".ReminderReceiver" android:exported="false"/>

        <!-- v2.5.0 (sección 4-b): resumen matutino diario -->
        <receiver android:name=".MorningReceiver" android:exported="false"/>

        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
