// ══════════════════════════════════════════════════════════════════════
// Reglas de seguridad de Firestore — AXONTECH
// ══════════════════════════════════════════════════════════════════════
// CÓMO USAR ESTE ARCHIVO:
// Firebase console → tu proyecto "axontech" → Firestore Database →
// pestaña "Reglas" → pegar este contenido completo → "Publicar".
//
// IMPORTANTE — límite real de esta protección:
// Esta app NO usa Firebase Authentication (usa contraseñas propias
// comparadas en el navegador, no inicio de sesión de Firebase). Eso
// significa que, a nivel de Firestore, un dispositivo de gestor y el
// dispositivo del admin son indistinguibles: ambos escriben con la misma
// clave pública de la app. Por eso estas reglas SOLO pueden validar la
// FORMA de los datos (que un vale tenga los campos correctos, que no
// pese demasiado, que no le falten campos obligatorios) — no pueden
// impedir que, en teoría, alguien con la clave pública de la app escriba
// datos con forma válida. Esto es el mismo nivel de exposición que ya
// tenía Realtime Database (que no tenía reglas de rol tampoco), así que
// NO es un paso atrás — es simplemente el límite real sin agregar login.
// Si en el futuro se quiere protección real por rol (que un gestor común
// NUNCA pueda tocar el campo "status" de un vale, por ejemplo), hay que
// agregar Firebase Authentication — es un proyecto aparte, más grande.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tamaño máximo generoso por documento — el límite real de Firestore
    // es 1 MiB (~1,048,576 bytes); acotamos más abajo para dejar margen.
    function tamañoRazonable() {
      return request.resource.size() < 900000;
    }

    match /gestores/{id} {
      allow read: if true;
      allow write: if tamañoRazonable()
                   && request.resource.data.keys().hasAll(['id', 'name']);
    }

    match /mensajeros/{id} {
      allow read: if true;
      allow write: if tamañoRazonable()
                   && request.resource.data.keys().hasAll(['id', 'name']);
    }

    match /productos/{id} {
      allow read: if true;
      allow write: if tamañoRazonable()
                   && request.resource.data.keys().hasAll(['id', 'name']);
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if tamañoRazonable()
                   && request.resource.data.keys().hasAll(['id', 'name']);
    }

    match /vales/{id} {
      allow read: if true;
      // Un vale siempre debe tener estos campos mínimos con la forma correcta.
      allow create: if tamañoRazonable()
                    && request.resource.data.keys().hasAll(['id', 'gestorId', 'ts', 'status'])
                    && request.resource.data.id is number
                    && request.resource.data.gestorId is number
                    && request.resource.data.status is string;
      // En update no se permite cambiar el dueño del vale (gestorId) —
      // evita que una escritura corrupta reasigne un vale a otro gestor.
      allow update: if tamañoRazonable()
                    && request.resource.data.gestorId == resource.data.gestorId;
      allow delete: if true;
    }

    // Documentos únicos (config, notifs, estafa, ranking_summary).
    match /meta/{doc} {
      allow read: if true;
      allow write: if tamañoRazonable();
    }

    // Snapshots de respaldo (pre-nuke, etc.) — mismo criterio.
    match /backups/{doc} {
      allow read: if true;
      allow write: if tamañoRazonable();
    }
  }
}
